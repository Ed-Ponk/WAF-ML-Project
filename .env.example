# ══════════════════════════════════════════════════════════════════
# .env.example — Plantilla de variables de entorno del WAF-ML.
#
# Copiá a .env y completá los valores. NUNCA subas .env al repo.
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── Entorno ──────────────────────────────────────────────────────
# development | production
WAF_ENV=development
TZ=America/Lima
WAF_DEBUG=false

# ── Seguridad (OBLIGATORIO en production) ─────────────────────────
# Secreto JWT para firmar tokens del dashboard. Generar uno nuevo de 64+ chars:
#   openssl rand -base64 48
JWT_SECRET=change_me_generar_con_openssl_rand_base64_48

# Cookie del dashboard: false en dev (http://localhost), true en prod
# (Nginx termina TLS; la cookie Secure solo debe viajar por https).
COOKIE_SECURE=false

# ── Dominios (nginx template) ─────────────────────────────────────
# Dev usa localhost + nombres .local (autofirmados). En prod poné
# los dominios reales apuntando (A/AAAA) a la IP del VPS.
WAF_DOMAIN=localhost
PYME_DOMAIN=pyme.waf.local
ADMIN_DOMAIN=admin.waf.local

# ── TLS ───────────────────────────────────────────────────────────
# Rutas DENTRO del contenedor proxy.
# Dev (autofirmados, ./certs):
#   CERT_PATH=/etc/nginx/certs/waf.crt
#   KEY_PATH=/etc/nginx/certs/waf.key
# Prod (Let's Encrypt via sidecar certbot):
#   CERT_PATH=/etc/letsencrypt/live/DOMINIO/fullchain.pem
#   KEY_PATH=/etc/letsencrypt/live/DOMINIO/privkey.pem
CERT_PATH=/etc/nginx/certs/waf.crt
KEY_PATH=/etc/nginx/certs/waf.key

# Let's Encrypt (dejar vacío = modo dev, sidecar idle)
# ACME_EMAIL=admin@example.com
# ACME_PRIMARY_DOMAIN=waf.example.com
# ACME_EXTRA_DOMAINS=admin.example.com

# ── PostgreSQL WAF (telemetría/dashboard) ─────────────────────────
DB_USER=waf_user
DB_PASSWORD=change_me_seguro
DB_NAME=waf_db
DB_PORT=5432

# ── MySQL PYME (backend) ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_seguro
DB_MYSQL_CONNECTION=mysql
DB_MYSQL_HOST=mysql
DB_MYSQL_PORT=3306
DB_MYSQL_DATABASE=bd_atel
DB_MYSQL_USERNAME=root
DB_MYSQL_PASSWORD=change_me_seguro

# ── ML Engine ─────────────────────────────────────────────────────
ML_ENGINE_PORT=8000
ML_MEMORY_LIMIT=800M
THRESHOLD_BLOCK=0.70
THRESHOLD_LOG=0.40
BACKEND_ALLOWLIST=http://pyme-php-backend:80

# ── Límites de recursos por contenedor (deploy.resources.limits) ──
DB_CPU_LIMIT=0.5
DB_MEMORY_LIMIT=512M
ML_CPU_LIMIT=1.0
PROXY_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=256M
PYME_FRONT_CPU_LIMIT=0.5
PYME_FRONT_MEMORY_LIMIT=512M
PYME_PHP_CPU_LIMIT=0.5
PYME_PHP_MEMORY_LIMIT=256M
MYSQL_CPU_LIMIT=1.0
MYSQL_MEMORY_LIMIT=512M
DASHBOARD_CPU_LIMIT=0.5
DASHBOARD_MEMORY_LIMIT=768M
VPN_CPU_LIMIT=0.25
VPN_MEMORY_LIMIT=128M

# --- Secretos del backend Laravel (pyme-php-backend) ---
# El compose los exige con ${VAR:?}; si falta alguno, docker compose up aborta.
# Formato: UNA sola linea, entre comillas dobles, con \n literales en vez de saltos reales.
#
# Generar APP_KEY:
#   docker run --rm -e APP_KEY php:8.2-apache-bullseye \
#     php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
#   OJO: rotar APP_KEY invalida todas las sesiones y cookies activas.
#
# Generar el par de llaves de Passport (PKCS#8, 4096 bits por defecto):
#   docker run --rm atel-back sh -c "php artisan passport:keys --force"
#   Copiar storage/oauth-private.key y storage/oauth-public.key, y pegar cada
#   una aqui con los saltos de linea convertidos en \n literales:
#   awk 'BEGIN{ORS="\\n"}{print}' storage/oauth-private.key
#   OJO: rotar la privada invalida todos los tokens emitidos y obliga a rehacer
#   los oauth_clients. Las llaves dejan de leerse de storage/ en cuanto se definen.
PYME_APP_KEY=
PYME_PASSPORT_PRIVATE_KEY=
PYME_PASSPORT_PUBLIC_KEY=
